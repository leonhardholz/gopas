program types(output);
type
  color = (red, green, blue);
  index = 1..10;
  letter = 'a'..'z';
  number = integer;
var
  c: color;
  i: index;
  ch: letter;
  n: number;
  k: -1..1;
procedure paint(x: color);
type
  shade = color;
var
  s: shade;
begin
  c := x;
  s := c
end;
begin
  paint(c)
end.
